{
  "name": "xtream-iptv-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mock:xtream": "node scripts/mock-xtream-server.mjs",
    "cap:init": "cap init \"Xtream IPTV\" \"com.xtream.iptvapp\" --web-dir=dist",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "android:open": "cap open android",
    "apk:build": "npm run build && npm run cap:sync && echo \"Build APK from Android Studio (Build > Build Bundle(s)/APK(s) > Build APK(s)).\""
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "hls.js": "^1.6.15",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
